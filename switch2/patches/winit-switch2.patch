+fn poll_nmouse(
+    nmouse: &mut Nmouse,
+    device_id: event::DeviceId,
+    out: &mut VecDeque<event::WindowEvent>,
+    dev_out: &mut VecDeque<DeviceEvent>,
+) {
+    let mut handle = ffi::HidNmouseHandle::default();
+    if unsafe { ffi::hidGetMergedNmouseHandle(&mut handle) } != 0 {
+        return;
+    }
+    let mut state = ffi::HidNmouseStateWithDelta::default();
+    let mut total: usize = 0;
+    if unsafe { ffi::hidGetNmouseStatesWithDelta(handle, &mut state, 1, &mut total) } != 0
+        || total == 0
+        || state.sampling_number == nmouse.sampling
+    {
+        return;
+    }
+    nmouse.sampling = state.sampling_number;
+
+    let mut type_set: u32 = 0;
+    let is_std_mouse = unsafe { ffi::hidGetNmouseTypeSet(handle, &mut type_set) } == 0
+        && (type_set & ffi::HID_NMOUSE_TYPE_STANDARD_MOUSE) != 0;
+
+    let moved = state.delta_x != 0 || state.delta_y != 0;
+    if moved {
+        if !nmouse.entered {
+            nmouse.entered = true;
+            out.push_back(event::WindowEvent::CursorEntered { device_id });
+        }
+        out.push_back(event::WindowEvent::CursorMoved {
+            device_id,
+            position: (state.x as f64, state.y as f64).into(),
+        });
+        dev_out.push_back(DeviceEvent::MouseMotion {
+            delta: (state.delta_x as f64, state.delta_y as f64),
+        });
+    }
+
+    // For a real USB/standard mouse, forward mouse buttons and scroll wheel.
+    // For Joy-Con 2, buttons (R/ZR/L/ZL) are handled cleanly by gilrs/Mouse Mode
+    // without double-firing, and the analog stick does not spam wheel_delta_y.
+    if is_std_mouse {
+        let changed = state.buttons ^ nmouse.buttons;
+        if changed != 0 {
+            for (bit, button) in [
+                (ffi::HID_MOUSE_BUTTON_LEFT, MouseButton::Left),
+                (ffi::HID_MOUSE_BUTTON_RIGHT, MouseButton::Right),
+                (ffi::HID_MOUSE_BUTTON_MIDDLE, MouseButton::Middle),
+            ] {
+                if changed & bit != 0 {
+                    let pressed = state.buttons & bit != 0;
+                    out.push_back(event::WindowEvent::MouseInput {
+                        device_id,
+                        state: if pressed { ElementState::Pressed } else { ElementState::Released },
+                        button,
+                    });
+                }
+            }
+            nmouse.buttons = state.buttons;
+        }
+
+        if state.wheel_delta_y != 0 {
+            out.push_back(event::WindowEvent::MouseWheel {
+                device_id,
+                delta: MouseScrollDelta::LineDelta(0.0, state.wheel_delta_y as f32),
+                phase: TouchPhase::Moved,
+            });
+        }
+    }
+}
+
+fn touch_pos(t: &ffi::HidTouchState) -> (f64, f64) {
+    // Horizon's hidGetTouchScreenStates always reports coordinates in 1280x720 space.
+    (
+        (t.x as f64) * (WIDTH as f64 / 1280.0),
+        (t.y as f64) * (HEIGHT as f64 / 720.0),
+    )
+}
+
 fn cursor(device_id: event::DeviceId, t: &ffi::HidTouchState) -> event::WindowEvent {
-    event::WindowEvent::CursorMoved { device_id, position: (t.x as f64, t.y as f64).into() }
+    event::WindowEvent::CursorMoved { device_id, position: touch_pos(t).into() }
 }
 
 fn finger(device_id: event::DeviceId, t: &ffi::HidTouchState, phase: TouchPhase) -> event::Touch {
     event::Touch {
         device_id,
         phase,
-        location: (t.x as f64, t.y as f64).into(),
+        location: touch_pos(t).into(),
         force: None,
         id: t.finger_id as u64,
     }
